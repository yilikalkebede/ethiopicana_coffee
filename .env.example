# Postgres (Prisma). DIRECT_URL is used for migrations when DATABASE_URL
# points at a pooler (e.g. PgBouncer / Supabase / Neon pooled connection).
DATABASE_URL=
DIRECT_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email provider (Resend/SendGrid/Postmark — see src/lib/email)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="Latitude Coffee Co. <hello@latitudecoffee.example>"

# Shipping provider — only EasyPost is actually implemented (see src/lib/shipping.ts)
SHIPPING_PROVIDER=easypost
SHIPPING_API_KEY=
SHIPPING_WEBHOOK_SECRET=

# Stripe Tax — off unless explicitly true. Requires registering a tax origin
# address in your own Stripe Dashboard (Settings -> Tax) first; enabling
# this before that's done will make every Checkout Session creation fail.
STRIPE_TAX_ENABLED=false

# Shared secret Vercel Cron sends as a Bearer token to /api/cron/* routes —
# generate any random string (e.g. `openssl rand -hex 32`).
CRON_SECRET=

# Vercel Blob (product image uploads) — Vercel dashboard -> Storage -> Create
# Database -> Blob, then Settings -> Environment Variables (or `.env.local`)
# for the local token. Uploads return a clear error until this is set.
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
