# Postgres (Prisma). DIRECT_URL is used for migrations when DATABASE_URL
# points at a pooler (e.g. PgBouncer / Supabase / Neon pooled connection).
DATABASE_URL=
DIRECT_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email provider (Resend/SendGrid/Postmark — see src/lib/email)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="Latitude Coffee Co. <hello@latitudecoffee.example>"

# Shipping provider — only EasyPost is actually implemented (see src/lib/shipping.ts)
SHIPPING_PROVIDER=easypost
SHIPPING_API_KEY=
SHIPPING_WEBHOOK_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
